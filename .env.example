# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env* 는 git 에 올라가지 않음, 이 예시 파일만 예외)
# Supabase 대시보드 → Project Settings → API Keys

# 프로젝트 URL (예: https://abcdefghijklmn.supabase.co)
SUPABASE_URL=

# Secret key (sb_secret_…) — 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 말 것 (붙이면 브라우저로 노출됨)
SUPABASE_SECRET_KEY=

# Publishable key (sb_publishable_…) — 로그인 세션(쿠키) 처리용. 서버에서만 사용 (NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_PUBLISHABLE_KEY=

# (선택) 로그인 아이디를 Auth 이메일로 바꿀 때 쓰는 내부 도메인. 기본 safety.local
# AUTH_EMAIL_DOMAIN=safety.local
